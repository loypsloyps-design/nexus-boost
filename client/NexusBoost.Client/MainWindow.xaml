<Window x:Class="NexusBoost.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS BOOST"
        Width="1380"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="235"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- SIDEBAR -->
		<Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="100"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="100"/>
				</Grid.RowDefinitions>

				<!-- LOGO -->
				<StackPanel Margin="24,24,10,0">

					<TextBlock Text="NEXUS"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

					<TextBlock Text="BOOST"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="14"
                               FontWeight="Bold"/>

				</StackPanel>

				<!-- MENU -->
				<StackPanel Grid.Row="1">

					<Button Style="{StaticResource MenuButton}"
                            Click="Home_Click"
                            Foreground="White"
                            Background="#10233A"
                            Content="⌂   Início"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Optimization_Click"
                            Content="⚡   Otimização"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Graphics_Click"
                            Content="◉   Gráficos e Imagem"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Games_Click"
                            Content="▶   Jogos"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Monitoring_Click"
                            Content="▥   Monitoramento"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Cleaning_Click"
                            Content="◇   Limpeza"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Tools_Click"
                            Content="⚙   Ferramentas"/>

					<Button Style="{StaticResource MenuButton}"
                            Click="Settings_Click"
                            Content="☷   Configurações"/>

				</StackPanel>

				<!-- LICENSE -->
				<Border Grid.Row="2"
                        Margin="14"
                        Padding="13"
                        Background="#0C1722"
                        BorderBrush="#17314A"
                        BorderThickness="1"
                        CornerRadius="9">

					<StackPanel>

						<TextBlock Text="LICENÇA"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"/>

						<StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0">

							<Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,8,0"/>

							<TextBlock Text="Sistema local"
                                       FontSize="12"
                                       Foreground="White"/>

						</StackPanel>

					</StackPanel>

				</Border>

			</Grid>

		</Border>

		<!-- MAIN -->
		<Grid Grid.Column="1">

			<Grid.RowDefinitions>
				<RowDefinition Height="70"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">

				<Grid Margin="28,0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel VerticalAlignment="Center">

						<TextBlock x:Name="PageTitle"
                                   Text="Visão Geral"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>

						<TextBlock x:Name="PageSubtitle"
                                   Text="Status e desempenho do seu computador"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,3,0,0"/>

					</StackPanel>

					<StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

						<Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0"/>

						<TextBlock Text="NEXUS ONLINE"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- CONTENT -->
			<ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

				<Grid Margin="28">

					<!-- DASHBOARD -->
					<StackPanel x:Name="DashboardPanel">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- CPU -->
							<Border Grid.Column="0"
                                    Margin="0,0,10,0"
                                    Padding="20"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">

								<StackPanel>

									<TextBlock Text="CPU"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"/>

									<TextBlock x:Name="CpuUsageText"
                                               Text="0%"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"/>

									<ProgressBar x:Name="CpuProgress"
                                                 Height="5"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"/>

									<TextBlock x:Name="CpuNameText"
                                               Text="Detectando processador..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,10,0,0"/>

								</StackPanel>

							</Border>

							<!-- GPU -->
							<Border Grid.Column="1"
                                    Margin="4,0,6,0"
                                    Padding="20"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">

								<StackPanel>

									<TextBlock Text="GPU"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"/>

									<TextBlock Text="ATIVA"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"/>

									<TextBlock x:Name="GpuNameText"
                                               Text="Detectando placa de vídeo..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,11,0,0"/>

								</StackPanel>

							</Border>

							<!-- RAM -->
							<Border Grid.Column="2"
                                    Margin="6,0,4,0"
                                    Padding="20"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">

								<StackPanel>

									<TextBlock Text="MEMÓRIA RAM"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"/>

									<TextBlock x:Name="RamUsageText"
                                               Text="0%"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"/>

									<ProgressBar x:Name="RamProgress"
                                                 Height="5"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"/>

									<TextBlock x:Name="RamDetailText"
                                               Text="Calculando..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,10,0,0"/>

								</StackPanel>

							</Border>

							<!-- DISK -->
							<Border Grid.Column="3"
                                    Margin="10,0,0,0"
                                    Padding="20"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">

								<StackPanel>

									<TextBlock Text="ARMAZENAMENTO"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"/>

									<TextBlock x:Name="DiskUsageText"
                                               Text="0%"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"/>

									<ProgressBar x:Name="DiskProgress"
                                                 Height="5"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"/>

									<TextBlock x:Name="DiskDetailText"
                                               Text="Calculando..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,10,0,0"/>

								</StackPanel>

							</Border>

						</Grid>

						<!-- HERO -->
						<Border Margin="0,20,0,0"
                                Padding="28"
                                Background="#0B1624"
                                BorderBrush="#153A60"
                                BorderThickness="1"
                                CornerRadius="14">

							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="280"/>
								</Grid.ColumnDefinitions>

								<StackPanel>

									<TextBlock Text="PRONTO PARA JOGAR?"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"/>

									<TextBlock Text="Prepare seu PC para a próxima partida"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"/>

									<TextBlock Text="O NEXUS analisará o sistema antes de qualquer alteração. Nenhuma otimização destrutiva é executada automaticamente."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxWidth="650"
                                               Margin="0,8,0,0"/>

								</StackPanel>

								<Button Grid.Column="1"
                                        Height="54"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="OptimizeButton_Click"
                                        Content="⚡  ANALISAR PARA JOGOS"/>

							</Grid>

						</Border>

						<!-- LOWER -->
						<Grid Margin="0,20,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- SYSTEM -->
							<Border Grid.Column="0"
                                    Margin="0,0,10,0"
                                    Padding="22"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">

								<StackPanel>

									<TextBlock Text="SEU COMPUTADOR"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>

									<Separator Margin="0,14"
                                               Background="{StaticResource BorderBrush}"/>

									<TextBlock Text="Sistema operacional"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"/>

									<TextBlock x:Name="OsText"
                                               Text="Detectando..."
                                               Margin="0,3,0,12"/>

									<TextBlock Text="Nome do dispositivo"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"/>

									<TextBlock x:Name="MachineText"
                                               Text="Detectando..."
                                               Margin="0,3,0,12"/>

									<TextBlock Text="Arquitetura"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"/>

									<TextBlock x:Name="ArchitectureText"
                                               Text="Detectando..."
                                               Margin="0,3,0,0"/>

								</StackPanel>

							</Border>

							<!-- STATUS -->
							<Border Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="22"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">

								<StackPanel>

									<TextBlock Text="STATUS DO NEXUS"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>

									<Separator Margin="0,14"
                                               Background="{StaticResource BorderBrush}"/>

									<TextBlock Text="●  Monitoramento"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,0,0,12"/>

									<TextBlock Text="●  Diagnóstico seguro"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,0,0,12"/>

									<TextBlock Text="●  Alterações do Windows bloqueadas nesta fase"
                                               Foreground="{StaticResource WarningBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

									<TextBlock Text="Versão 1.0.0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"/>

								</StackPanel>

							</Border>

						</Grid>

					</StackPanel>

					<!-- GENERIC MODULE -->
					<StackPanel x:Name="ModulePanel"
                                Visibility="Collapsed">

						<Border Padding="30"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

							<StackPanel>

								<TextBlock x:Name="ModuleIcon"
                                           Text="⚡"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="34"/>

								<TextBlock x:Name="ModuleTitle"
                                           Text="Módulo"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,0"/>

								<TextBlock x:Name="ModuleDescription"
                                           Text="Descrição"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

								<Border Margin="0,25,0,0"
                                        Padding="18"
                                        Background="#09121C"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">

									<TextBlock x:Name="ModuleStatus"
                                               Text="Módulo preparado para implementação."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"/>

								</Border>

								<Button Width="190"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Margin="0,20,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BackHome_Click"
                                        Content="Voltar ao início"/>

							</StackPanel>

						</Border>

					</StackPanel>

				</Grid>

			</ScrollViewer>

		</Grid>

	</Grid>

</Window>